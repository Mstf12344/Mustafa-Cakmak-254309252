DirectoryIndex index.php
Options -Indexes

# clean URLs for the legal pages: /gizlilik and /kosullar
RewriteEngine On
RewriteRule ^(gizlilik|kosullar)/?$ $1.php [L]

# the JSON data files are only served through data.php
<FilesMatch "\.json$">
  Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/css application/javascript
</IfModule>

# static assets are versioned (?v=mtime), so they can be cached for a long time
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
